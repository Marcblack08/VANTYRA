rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'marcjjbeltran08@gmail.com';
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /carts/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /carts/{userId}/items/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /favorites/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /orders/{orderId}/items/{itemId} {
      allow read: if signedIn() &&
        (get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}